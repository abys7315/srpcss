# ==============================================================================
# SIH 26120 — DIGITAL TWIN FOR CSS & SRP OPERATIONS (BAGHEWALA FIELD)
# Environment Configuration Template
# Copy this file to .env and adjust variables as required for local development.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME="SIH-26120-Digital-Twin"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS Origins (comma-separated origins; no JSON brackets)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Local development default: SQLite fallback. Production/Docker default: PostgreSQL
DATABASE_URL=sqlite:///./sih_digital_twin.db
# PostgreSQL example:
# DATABASE_URL=postgresql://sih_user:sih_password@localhost:5432/sih_baghewala_db

POSTGRES_SERVER=localhost
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=sih_password
POSTGRES_DB=sih_baghewala_db
POSTGRES_PORT=5432

# Digital Twin Simulation & Optimization Engine
OPTIMIZER_POP_SIZE=8
OPTIMIZER_GENS=4
DEFAULT_CONFIDENCE_THRESHOLD=0.75
STRICT_SAFETY_CONSTRAINTS=True

# Security & Demo Mode
DEMO_MODE=False
ENABLE_DOCS=True

# Data Provenance & Safety
DEFAULT_PROVENANCE_MODE=SIMULATED
ALLOW_UNVALIDATED_FIELD_OVERRIDE=False
FIELD_NAME="Baghewala"

# Model Registry Path
MODEL_REGISTRY_PATH=./ml/registry/artifacts

# Copilot LLM providers (backend only; never expose to the frontend)
GEMINI_API_KEY=
GROQ_API_KEY=

# Vite Frontend Variables (Prefix with VITE_)
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE="SIH 26120 Digital Twin"
VITE_DEFAULT_FIELD="Baghewala"
