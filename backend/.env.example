# Backend Environment Configuration Template
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME="PETRO-TWIN"

# Server & CORS
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=

# Database
DATABASE_URL=sqlite:///./sih_digital_twin.db

# Optimization Engine
OPTIMIZER_POP_SIZE=8
OPTIMIZER_GENS=4

# Demo Mode & Security
DEMO_MODE=False
ENABLE_DOCS=True

# LLM Providers (backend only)
GEMINI_API_KEY=
GROQ_API_KEY=
